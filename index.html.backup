<!DOCTYPE html>
<html lang="es" class="scroll-smooth bg-[#01122a] text-[#f1f5f9]">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Scroll — Propuesta Estratégica: Plataforma Asesores IA para WhatsApp</title>

  <!-- Google Fonts: Montserrat (Display), Poppins (Body), Kaushan Script (Acentos Scroll) -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Kaushan+Script&family=Montserrat:ital,wght@0,600;0,700;0,800;0,900;1,700;1,900&family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">

  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>

  <!-- Lucide Icons -->
  <script src="https://unpkg.com/lucide@latest"></script>

  <!-- GSAP 3 & ScrollTrigger -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js"></script>

  <!-- Canvas Confetti -->
  <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.9.3/dist/confetti.browser.min.js" defer></script>

  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            scroll: {
              navy: '#01122a',
              dark: '#031b3d',
              blue: '#033369',
              deep: '#022751',
              petroleo: '#043E71',
              turquesa: '#02CCB5',
              turquesaLight: '#02E7C1',
              lima: '#AEF905',
              limaHover: '#98dc03',
              papel: '#F5F4F3',
              tinta: '#1E2B8C'
            }
          },
          fontFamily: {
            display: ['Montserrat', 'sans-serif'],
            body: ['Poppins', 'sans-serif'],
            script: ['Kaushan Script', 'cursive']
          }
        }
      }
    }
  </script>

  <style>
    :root {
      --bg-dark: #01122a;
      --scroll-grad: linear-gradient(135deg, #043E71 0%, #036A86 40%, #02CCB5 80%, #02E7C1 100%);
      --border-turquesa: rgba(2, 204, 181, 0.22);
    }

    body {
      background-color: var(--bg-dark);
      color: #f1f5f9;
      font-family: 'Poppins', sans-serif;
      overflow-x: hidden;
      cursor: default;
    }

    /* Ambient Live GPU Canvas */
    #ambient-canvas {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      pointer-events: none;
      z-index: 0;
      transform: translateZ(0);
    }

    /* Subtle Film Grain */
    .film-grain {
      position: fixed;
      inset: 0;
      width: 100%;
      height: 100%;
      pointer-events: none;
      z-index: 1;
      opacity: 0.035;
      background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.8' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)'/%3E%3C/svg%3E");
    }

    /* Gradient Shimmers */
    .text-gradient-scroll {
      background: linear-gradient(135deg, #FFFFFF 15%, #02E7C1 60%, #AEF905 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }
    .text-gradient-turquesa {
      background: linear-gradient(135deg, #02E7C1 0%, #02CCB5 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }

    /* Luxury Bezel Chassis (Casa Tradición Style) */
    .bezel-chassis {
      background: linear-gradient(145deg, rgba(3, 27, 61, 0.88) 0%, rgba(1, 18, 42, 0.95) 100%);
      border: 1px solid rgba(2, 204, 181, 0.22);
      border-radius: 1.5rem;
      box-shadow: 0 16px 36px -10px rgba(0, 0, 0, 0.75), inset 0 1px 1px rgba(255, 255, 255, 0.1);
      transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.35s ease, box-shadow 0.35s ease;
      transform: translateZ(0);
    }
    .bezel-chassis:hover {
      border-color: rgba(174, 249, 5, 0.45);
      box-shadow: 0 24px 48px -12px rgba(0, 0, 0, 0.85), 0 0 24px rgba(2, 204, 181, 0.15), inset 0 1px 1px rgba(255, 255, 255, 0.2);
      transform: translateY(-3px);
    }

    /* Magnetic Primary Button */
    .btn-luxury-magnetic {
      background: linear-gradient(135deg, #AEF905 0%, #98DC03 100%);
      color: #01122a;
      font-weight: 800;
      border-radius: 9999px;
      padding: 0.85rem 1.75rem;
      display: inline-flex;
      align-items: center;
      gap: 0.75rem;
      transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.3s ease;
      box-shadow: 0 10px 25px -5px rgba(174, 249, 5, 0.4);
      transform: translateZ(0);
    }
    .btn-luxury-magnetic:hover {
      transform: translateY(-2px) scale(1.02);
      box-shadow: 0 16px 32px -5px rgba(174, 249, 5, 0.6);
    }
    .btn-luxury-magnetic .icon-bubble {
      width: 1.85rem;
      height: 1.85rem;
      border-radius: 9999px;
      background: rgba(1, 18, 42, 0.18);
      display: flex;
      align-items: center;
      justify-content: center;
      transition: transform 0.25s ease;
    }
    .btn-luxury-magnetic:hover .icon-bubble {
      transform: translateX(3px);
    }

    /* Custom Precision Cursor */
    #custom-cursor {
      position: fixed;
      top: 0;
      left: 0;
      width: 32px;
      height: 32px;
      border: 1.5px solid rgba(2, 204, 181, 0.7);
      border-radius: 50%;
      pointer-events: none;
      z-index: 9999;
      transform: translate3d(-100px, -100px, 0);
      transition: width 0.2s, height 0.2s, background-color 0.2s, border-color 0.2s;
      will-change: transform;
    }
    #custom-cursor-dot {
      position: fixed;
      top: 0;
      left: 0;
      width: 6px;
      height: 6px;
      background-color: #AEF905;
      border-radius: 50%;
      pointer-events: none;
      z-index: 10000;
      transform: translate3d(-100px, -100px, 0);
      will-change: transform;
    }

    /* 3D Calling Logo Floating & Ringing Animations */
    @keyframes logo-3d-idle {
      0%, 100% {
        transform: rotateY(-8deg) rotateX(6deg) translateY(0px);
      }
      50% {
        transform: rotateY(8deg) rotateX(-4deg) translateY(-6px);
      }
    }

    @keyframes call-ripple {
      0% { transform: scale(0.85); opacity: 0.9; }
      50% { transform: scale(1.4); opacity: 0.4; }
      100% { transform: scale(1.9); opacity: 0; }
    }

    .animate-call-ripple-1 {
      animation: call-ripple 2.4s cubic-bezier(0, 0.2, 0.8, 1) infinite;
    }
    .animate-call-ripple-2 {
      animation: call-ripple 2.4s cubic-bezier(0, 0.2, 0.8, 1) 0.8s infinite;
    }
    .animate-call-ripple-3 {
      animation: call-ripple 2.4s cubic-bezier(0, 0.2, 0.8, 1) 1.6s infinite;
    }

    .logo-3d-floating {
      transform-style: preserve-3d;
      animation: logo-3d-idle 5s ease-in-out infinite;
    }

    /* Phone Mockups */
    .phone-mockup {
      border-radius: 36px;
      box-shadow: 0 25px 60px -15px rgba(0, 0, 0, 0.8), 0 0 30px rgba(2, 204, 181, 0.12);
      border: 1px solid rgba(2, 204, 181, 0.25);
      position: relative;
      overflow: hidden;
      transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .phone-mockup:hover {
      transform: translateY(-5px);
      border-color: rgba(174, 249, 5, 0.5);
      box-shadow: 0 30px 70px -15px rgba(0, 0, 0, 0.9), 0 0 35px rgba(174, 249, 5, 0.2);
    }

    /* Range slider custom styling */
    input[type=range] {
      -webkit-appearance: none;
      background: #033369;
      border-radius: 9999px;
      height: 8px;
    }
    input[type=range]::-webkit-slider-thumb {
      -webkit-appearance: none;
      height: 22px;
      width: 22px;
      border-radius: 50%;
      background: #AEF905;
      cursor: pointer;
      box-shadow: 0 0 12px rgba(174, 249, 5, 0.8);
      border: 2px solid #01122a;
    }

    /* Typing Animation */
    @keyframes typing {
      0%, 80%, 100% { transform: scale(0.6); opacity: 0.4; }
      40% { transform: scale(1); opacity: 1; }
    }
    .typing-dot-1 { animation: typing 1.4s infinite 0s; }
    .typing-dot-2 { animation: typing 1.4s infinite 0.2s; }
    .typing-dot-3 { animation: typing 1.4s infinite 0.4s; }

    /* Custom Scrollbar */
    ::-webkit-scrollbar { width: 7px; }
    ::-webkit-scrollbar-track { background: #01122a; }
    ::-webkit-scrollbar-thumb {
      background: #033369;
      border-radius: 8px;
    }
    ::-webkit-scrollbar-thumb:hover { background: #02CCB5; }

    @media print {
      body {
        background: #ffffff !important;
        color: #01122a !important;
      }
      .no-print {
        display: none !important;
      }
      .bezel-chassis, .phone-mockup {
        background: #ffffff !important;
        border: 1px solid #cbd5e1 !important;
        box-shadow: none !important;
        color: #0f172a !important;
      }
      .text-gradient-scroll, .text-gradient-turquesa {
        -webkit-text-fill-color: #033369 !important;
      }
    }
  </style>
</head>
<body class="min-h-screen antialiased selection:bg-scroll-lima selection:text-scroll-navy relative">

  <!-- Ambient Live GPU Canvas (Scroll Volumetric Orbs & Embers) -->
  <canvas id="ambient-canvas"></canvas>

  <!-- Film Grain Overlay -->
  <div class="film-grain"></div>

  <!-- Custom Magnetic Cursor -->
  <div id="custom-cursor" class="hidden md:block"></div>
  <div id="custom-cursor-dot" class="hidden md:block"></div>

  <!-- Fullscreen Portal Flash for Scroll Zoom-In Transition -->
  <div id="dive-portal-curtain" class="fixed inset-0 pointer-events-none z-40 opacity-0 bg-gradient-to-b from-scroll-turquesa/30 via-scroll-petroleo/70 to-[#01122a] backdrop-blur-md"></div>

  <!-- Main Content Layer -->
  <div class="relative z-10 w-full overflow-x-clip">

    <!-- ============================================================== -->
    <!-- PINNED HERO: WRAPPER PARA SCROLL INMERSIVO CON STICKY NATIVO GPU -->
    <!-- ============================================================== -->
    <div id="hero-pin-wrapper" class="relative w-full" style="height: 190vh;">
      <section id="hero-stage" class="sticky top-0 h-screen w-full flex items-center justify-center overflow-hidden perspective-[1200px] z-20 bg-[#01122a]">
      
      <!-- Stage Ambient Background Orbs -->
      <div class="absolute inset-0 pointer-events-none">
        <div class="absolute top-1/4 left-1/4 w-[450px] h-[450px] bg-scroll-petroleo/30 rounded-full blur-[120px]"></div>
        <div class="absolute bottom-1/4 right-1/4 w-[450px] h-[450px] bg-scroll-turquesa/20 rounded-full blur-[120px]"></div>
      </div>

      <!-- 3-COLUMNS HERO GRID: INFO IZQUIERDA | CELULAR CENTRADO | INFO DERECHA -->
      <div class="w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-full flex items-center justify-between relative z-20">
        
        <!-- COLUMNA IZQUIERDA: MENSAJE ESTRATÉGICO & PROPUESTA DE VALOR -->
        <div id="hero-left-col" class="w-full lg:w-4/12 text-center lg:text-left space-y-4 pointer-events-auto">
          
          <!-- Micro-Badge Superior -->
          <div class="inline-flex items-center gap-2.5 px-4 py-1.5 rounded-full bezel-chassis border border-scroll-turquesa/40 shadow-xl">
            <span class="w-2.5 h-2.5 rounded-full bg-scroll-lima animate-ping"></span>
            <span class="text-[11px] font-bold uppercase tracking-widest text-scroll-turquesaLight font-display">Propuesta Estratégica 2026</span>
          </div>

          <!-- Titular Monumental -->
          <h1 class="text-2xl sm:text-4xl lg:text-4.5xl font-display font-black tracking-tight leading-[1.12] text-white">
            El Marketing de Scroll ya no es un gasto:
            <br>
            es una <span class="text-gradient-scroll font-script font-bold normal-case text-3xl sm:text-5xl lg:text-6xl tracking-normal inline-block transform -rotate-1">máquina de ventas</span>
          </h1>

          <!-- Subtítulo -->
          <p class="text-xs sm:text-sm text-slate-300 leading-relaxed font-normal max-w-md mx-auto lg:mx-0">
            Plataforma web propia multi-empresa con marca de Scroll. Cada cliente tiene un 
            <strong class="text-white font-semibold">Asesor con IA en WhatsApp</strong> que atiende en &lt;10s, filtra curiosos y entrega leads calificados con dinero al vendedor humano.
          </p>

          <!-- Pastillas Rápidas de Confianza -->
          <div class="pt-2 flex flex-wrap items-center justify-center lg:justify-start gap-2 text-[11px]">
            <span class="px-3 py-1 rounded-full bg-scroll-blue/50 border border-scroll-turquesa/30 text-scroll-turquesaLight font-semibold">
              ✓ 100% Multi-Empresa Aislado
            </span>
            <span class="px-3 py-1 rounded-full bg-scroll-blue/50 border border-scroll-lima/30 text-scroll-lima font-semibold">
              ✓ Respuesta &lt; 10 seg 24/7
            </span>
            <span class="px-3 py-1 rounded-full bg-scroll-blue/50 border border-white/20 text-white font-semibold">
              ✓ Pereira, Colombia
            </span>
          </div>

        </div>

        <!-- ESPACIADOR CENTRAL EN EL GRID PARA QUE EL CELULAR FLOTE EN EL MEDIO -->
        <div class="hidden lg:block lg:w-4/12 pointer-events-none"></div>

        <!-- COLUMNA DERECHA: PILARES CLAVE DE LA COTIZACIÓN -->
        <div id="hero-right-col" class="w-full lg:w-4/12 space-y-3.5 text-left pointer-events-auto">
          
          <!-- Pilar 1 -->
          <div class="bezel-chassis p-4 space-y-1 border-l-4 border-l-scroll-turquesa">
            <div class="flex items-center justify-between">
              <span class="text-[10px] uppercase font-bold text-slate-400 font-display">Arquitectura</span>
              <i data-lucide="shield-check" class="w-4 h-4 text-scroll-turquesa"></i>
            </div>
            <h4 class="text-sm font-bold text-white">100% Multi-Empresa Aislado</h4>
            <p class="text-xs text-slate-300 leading-relaxed">
              Cada cliente de Scroll entra con su usuario y contraseña a su propio portal. Datos y chats totalmente privados.
            </p>
          </div>

          <!-- Pilar 2 -->
          <div class="bezel-chassis p-4 space-y-1 border-l-4 border-l-scroll-lima bg-scroll-lima/5">
            <div class="flex items-center justify-between">
              <span class="text-[10px] uppercase font-bold text-scroll-lima font-display">La Firma de Scroll</span>
              <i data-lucide="users" class="w-4 h-4 text-scroll-lima"></i>
            </div>
            <h4 class="text-sm font-bold text-white">19 Horas de Oro In Situ</h4>
            <p class="text-xs text-slate-300 leading-relaxed">
              Inmersión presencial dentro del negocio del cliente. No vendemos un bot frío; entregamos consultoría real.
            </p>
          </div>

          <!-- Pilar 3 -->
          <div class="bezel-chassis p-4 space-y-1 border-l-4 border-l-scroll-turquesaLight">
            <div class="flex items-center justify-between">
              <span class="text-[10px] uppercase font-bold text-scroll-turquesaLight font-display">Retención Indiscutible</span>
              <i data-lucide="trending-up" class="w-4 h-4 text-scroll-turquesaLight"></i>
            </div>
            <h4 class="text-sm font-bold text-white">Demostración de ROI en Vivo</h4>
            <p class="text-xs text-slate-300 leading-relaxed">
              Métricas mensuales de leads atendidos y calificados. El cliente ve el retorno y no puede cancelar su plan de marketing.
            </p>
          </div>

          <!-- Botón de Inmersión Rápida -->
          <div class="pt-2 text-center lg:text-left">
            <button onclick="answerCall()" class="w-full py-3.5 rounded-full text-xs font-extrabold bg-gradient-to-r from-scroll-lima to-scroll-limaHover text-scroll-navy shadow-xl shadow-scroll-lima/30 transition flex items-center justify-center gap-2 group hover:scale-[1.02]">
              <span>Comenzar Presentación (Contestar)</span>
              <i data-lucide="phone" class="w-4 h-4 group-hover:scale-110 transition-transform"></i>
            </button>
          </div>

        </div>

      </div>

      <!-- ============================================================== -->
      <!-- CENTRO ABSOLUTO: EL CELULAR (ACTOR PRINCIPAL) & LA FLECHA 3D -->
      <!-- FLOTA EXACTAMENTE AL CENTRO DE LA PANTALLA, SIN CORTES NI BANDAS -->
      <!-- ============================================================== -->
      <div id="hero-center-actor-wrap" class="absolute inset-0 flex items-center justify-center pointer-events-none z-25 [transform-style:preserve-3d]">
        
        <!-- Smartphone Chassis -->
        <div id="hero-phone-mockup" class="w-[285px] sm:w-[310px] h-[500px] sm:h-[530px] bg-[#021324] rounded-[46px] p-3 shadow-2xl border-2 border-scroll-turquesa/50 relative flex flex-col justify-between overflow-hidden shadow-scroll-turquesa/30 [transform-style:preserve-3d] transform-gpu pointer-events-auto">
          
          <!-- Dynamic Island / Speaker Notch -->
          <div id="phone-notch" class="absolute top-2.5 left-1/2 -translate-x-1/2 w-28 h-5 bg-black rounded-full z-40 flex items-center justify-between px-2.5">
            <span class="w-2.5 h-2.5 rounded-full bg-scroll-petroleo"></span>
            <div class="w-10 h-1 bg-white/20 rounded-full"></div>
            <span class="w-2 h-2 rounded-full bg-scroll-lima animate-pulse"></span>
          </div>

          <!-- Phone Screen Content (Call Interface) -->
          <div id="phone-screen-inner" class="w-full h-full rounded-[36px] bg-gradient-to-b from-[#032442] via-[#02182c] to-[#011021] flex flex-col justify-between p-5 text-center relative overflow-hidden border border-white/10">
            
            <!-- Background Light Glow Inside Phone -->
            <div class="absolute top-1/4 left-1/2 -translate-x-1/2 w-48 h-48 bg-scroll-turquesa/20 rounded-full blur-3xl pointer-events-none"></div>

            <!-- Top Call Header -->
            <div id="call-header" class="pt-6 z-10 transition-opacity">
              <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-white/10 text-scroll-turquesaLight text-[10px] font-bold uppercase tracking-wider mb-1.5">
                <i data-lucide="phone-call" class="w-3 h-3 text-scroll-lima animate-bounce"></i>
                <span>WhatsApp Audio</span>
              </div>
              <h3 class="text-base sm:text-lg font-display font-extrabold text-white tracking-tight">
                Scroll Asesor IA
              </h3>
              <p class="text-[11px] text-scroll-turquesaLight font-medium">Llamada de ventas entrante...</p>
            </div>

            <!-- Center Call Base Anchor (Plinth & Sonic Waves) -->
            <div id="call-base-plinth" class="relative my-auto flex items-center justify-center z-10 py-3">
              <!-- Expanding Sonic Ripple Waves -->
              <div class="absolute w-28 h-28 rounded-full border border-scroll-lima/40 animate-ping pointer-events-none"></div>
              <div class="absolute w-36 h-36 rounded-full border border-scroll-turquesa/30 pointer-events-none"></div>
              <div class="absolute w-44 h-44 rounded-full border border-scroll-lima/20 pointer-events-none"></div>

              <!-- Base White Disc Plinth -->
              <div class="w-28 h-28 sm:w-32 sm:h-32 rounded-full p-1.5 bg-gradient-to-tr from-scroll-blue via-scroll-turquesa to-scroll-lima shadow-2xl relative flex items-center justify-center border border-white/40 shadow-scroll-turquesa/40">
                <div class="w-full h-full rounded-full bg-white flex items-center justify-center relative overflow-hidden shadow-inner">
                  <!-- Clean pure white plinth disc bed for the arrow -->
                </div>
              </div>
            </div>

            <!-- Bottom Call Actions -->
            <div id="call-footer" class="pb-3 z-10 space-y-2.5 transition-opacity">
              <div class="flex items-center justify-around max-w-[190px] mx-auto">
                <!-- Decline Button -->
                <div class="flex flex-col items-center gap-1 opacity-70 hover:opacity-100 transition-opacity cursor-pointer">
                  <div class="w-11 h-11 rounded-full bg-red-600 text-white flex items-center justify-center shadow-lg text-sm">
                    <i data-lucide="phone-off" class="w-4 h-4"></i>
                  </div>
                  <span class="text-[9px] text-slate-400">Rechazar</span>
                </div>

                <!-- Accept / Answer Button (Interactive) -->
                <div class="flex flex-col items-center gap-1 cursor-pointer group" onclick="answerCall()">
                  <div class="w-13 h-13 sm:w-14 sm:h-14 rounded-full bg-scroll-lima text-scroll-navy flex items-center justify-center shadow-xl shadow-scroll-lima/40 font-bold group-hover:scale-110 transition-transform">
                    <i data-lucide="phone" class="w-6 h-6 animate-pulse"></i>
                  </div>
                  <span class="text-[10px] text-scroll-lima font-bold">Contestar</span>
                </div>
              </div>

              <!-- Animated Hint To Scroll & Dive Inside -->
              <div class="pt-1">
                <p class="text-[10px] text-slate-300 font-medium flex items-center justify-center gap-1">
                  <span>Desliza para sumergirte</span>
                  <i data-lucide="chevrons-down" class="w-3.5 h-3.5 text-scroll-lima animate-bounce"></i>
                </p>
              </div>
            </div>

          </div>

        </div>

        <!-- ============================================================== -->
        <!-- LA FLECHA DE SCROLL COMPLETA: CUERPO CURVO AZUL + CABEZA LIMA -->
        <!-- EL ACTOR PRINCIPAL 3D (DESPRENDIBLE) QUE SALE DE LA PANTALLA -->
        <!-- ORBITA EL CELULAR Y SE ADENTRA EN LA PANTALLA CON NOSOTROS -->
        <!-- ============================================================== -->
        <div id="scroll-lime-arrow-3d" class="absolute z-50 pointer-events-none [transform-style:preserve-3d] flex items-center justify-center cursor-pointer pointer-events-auto" style="width: 120px; height: 120px;" onclick="answerCall()" title="Haz clic para contestar">
          
          <!-- Outer Pulsing Glow Aura -->
          <div id="arrow-trail-glow" class="absolute inset-0 rounded-full bg-scroll-turquesa/25 blur-2xl animate-pulse"></div>

          <!-- Pure Vector Authentic Scroll Emblem (Curved Blue Body + Lime Head) -->
          <svg viewBox="0 0 150 150" class="w-full h-full drop-shadow-[0_10px_25px_rgba(1,18,42,0.45)]">
            <defs>
              <!-- Gradient for the blue curved body (la curvita azul / chat) -->
              <linearGradient id="scrollBlueBodyGrad" x1="10%" y1="0%" x2="90%" y2="100%">
                <stop offset="0%" stop-color="#02E7C1"/>
                <stop offset="35%" stop-color="#02CCB5"/>
                <stop offset="70%" stop-color="#034B8C"/>
                <stop offset="100%" stop-color="#012751"/>
              </linearGradient>

              <!-- Official Lime Arrow Head Gradient (el triángulo verde lima) -->
              <linearGradient id="scrollLimeHeadGrad" x1="0%" y1="100%" x2="100%" y2="0%">
                <stop offset="0%" stop-color="#8fd300"/>
                <stop offset="55%" stop-color="#AEF905"/>
                <stop offset="100%" stop-color="#FFFFFF"/>
              </linearGradient>

              <!-- Neon Glow Filter for Lime Head -->
              <filter id="scrollArrowGlow" x="-20%" y="-20%" width="140%" height="140%">
                <feDropShadow dx="0" dy="2" stdDeviation="3" flood-color="#AEF905" flood-opacity="0.85"/>
              </filter>
            </defs>

            <!-- 1. El Cuerpo Curvo de la Flecha (Curvita Azul / Chat) -->
            <path d="
              M 57 40.5
              C 63 40.5 67.5 44.5 67.5 50
              C 67.5 55 63 60 58.5 64
              C 55.5 67 54.5 73 56.5 79
              C 57.5 82 61 85 64.5 88.5
              L 64 96.5
              L 73 92
              C 79 91.5 86 88 90.5 84.5
              L 106 94
              C 97.5 103 85 108.5 72.5 108.5
              C 53.5 108.5 38 93.5 38 74.5
              C 38 56 46.5 43.5 57 40.5 Z
            " fill="url(#scrollBlueBodyGrad)"/>

            <!-- 2. La Cabeza de la Flecha (Triángulo Verde Lima con Esquinas Redondeadas) -->
            <path d="
              M 87 61
              L 108 61
              C 112 61 113.5 62.5 113.5 66.5
              L 113.5 85
              C 113.5 88.5 110 89.5 107 86.5
              L 85 64.5
              C 82 61.5 83 61 87 61 Z
            " fill="url(#scrollLimeHeadGrad)" filter="url(#scrollArrowGlow)"/>
          </svg>

          <!-- Floating Notification Badge on the arrow head -->
          <div id="arrow-notification-badge" class="absolute top-1 right-1 w-6 h-6 rounded-full bg-white text-scroll-navy font-black text-xs flex items-center justify-center border-2 border-scroll-navy shadow-lg shadow-white/50">
            1
          </div>

        </div>

      </div>

      <!-- ============================================================== -->
      <!-- DIMENSIÓN MARKETING: CÁMARAS, MICRÓFONOS, MOUSE, CLAQUETA, ADS -->
      <!-- ENTRAN CON NOSOTROS AL ADENTRARNOS EN EL CELULAR EN 3D -->
      <!-- ============================================================== -->
      <div id="marketing-dimension" class="absolute inset-0 pointer-events-none z-30 flex items-center justify-center opacity-0 [transform-style:preserve-3d]">
        
        <!-- Warp Tunnel Grid Background -->
        <div class="absolute inset-0 bg-[radial-gradient(#02CCB5_1.5px,transparent_1.5px)] [background-size:32px_32px] opacity-40"></div>

        <!-- 1. CÁMARA DE CINE & VIDEO 4K -->
        <div id="mkt-camera" class="absolute p-4 rounded-2xl bg-[#032442]/95 border-2 border-scroll-turquesa shadow-2xl flex items-center gap-3 backdrop-blur-xl shadow-scroll-turquesa/30">
          <div class="w-12 h-12 rounded-xl bg-scroll-turquesa/20 flex items-center justify-center text-scroll-turquesa">
            <i data-lucide="video" class="w-6 h-6"></i>
          </div>
          <div class="text-left">
            <span class="text-[10px] text-slate-400 font-bold uppercase block">Cámaras 4K</span>
            <span class="text-sm font-black text-white">Producción & Reels</span>
          </div>
        </div>

        <!-- 2. MICRÓFONO DE ESTUDIO / PODCAST -->
        <div id="mkt-mic" class="absolute p-4 rounded-2xl bg-[#032442]/95 border-2 border-scroll-lima shadow-2xl flex items-center gap-3 backdrop-blur-xl shadow-scroll-lima/30">
          <div class="w-12 h-12 rounded-xl bg-scroll-lima/20 flex items-center justify-center text-scroll-lima">
            <i data-lucide="mic" class="w-6 h-6"></i>
          </div>
          <div class="text-left">
            <span class="text-[10px] text-slate-400 font-bold uppercase block">Audio Pro</span>
            <span class="text-sm font-black text-white">Micrófonos Podcast</span>
          </div>
        </div>

        <!-- 3. MOUSE Y CURSOR DE DISEÑO / PAUTA ADS -->
        <div id="mkt-mouse" class="absolute p-4 rounded-2xl bg-[#02182c]/95 border-2 border-white/40 shadow-2xl flex items-center gap-3 backdrop-blur-xl shadow-white/20">
          <div class="w-12 h-12 rounded-xl bg-white/20 flex items-center justify-center text-white">
            <i data-lucide="mouse-pointer" class="w-6 h-6"></i>
          </div>
          <div class="text-left">
            <span class="text-[10px] text-slate-400 font-bold uppercase block">Tráfico Digital</span>
            <span class="text-sm font-black text-white">Pauta Meta & Google</span>
          </div>
        </div>

        <!-- 4. CLAQUETA DE FILMACIÓN / SET DE RODAJE -->
        <div id="mkt-clapper" class="absolute p-4 rounded-2xl bg-[#032442]/95 border-2 border-scroll-turquesaLight shadow-2xl flex items-center gap-3 backdrop-blur-xl shadow-scroll-turquesaLight/30">
          <div class="w-12 h-12 rounded-xl bg-scroll-turquesaLight/20 flex items-center justify-center text-scroll-turquesaLight">
            <i data-lucide="clapperboard" class="w-6 h-6"></i>
          </div>
          <div class="text-left">
            <span class="text-[10px] text-slate-400 font-bold uppercase block">Set de Rodaje</span>
            <span class="text-sm font-black text-white">Guiones & Luces</span>
          </div>
        </div>

        <!-- 5. TICKET DE LEAD CALIFICADO CON DINERO -->
        <div id="mkt-ticket" class="absolute p-5 rounded-3xl bg-gradient-to-r from-scroll-petroleo via-scroll-blue to-scroll-turquesa/40 border-2 border-scroll-lima shadow-2xl text-center backdrop-blur-2xl shadow-scroll-lima/40">
          <div class="flex items-center justify-center gap-2 text-scroll-lima mb-1 font-bold text-xs">
            <i data-lucide="badge-dollar-sign" class="w-5 h-5 animate-bounce"></i>
            <span class="tracking-widest uppercase font-display">Lead Calificado con Dinero</span>
          </div>
          <h3 class="text-2xl sm:text-3xl font-black text-white font-display tracking-tight">$2.500.000 COP</h3>
          <p class="text-xs text-slate-200 mt-1 font-medium">Cliente listo entregado al asesor humano de Scroll</p>
        </div>

      </div>

    </section>
    </div>


    <!-- ============================================================== -->
    <!-- SECCIÓN 2: VISIÓN & BENTO GRID: EL PROBLEMA REAL QUE RESUELVE -->
    <!-- (AQUÍ ATERRIZAS DESPUÉS DE LA INMERSIÓN DEL CELULAR) -->
    <!-- ============================================================== -->
    <section id="vision" class="pt-14 pb-24 px-4 sm:px-6 max-w-7xl mx-auto border-t border-white/10 relative">
      
      <div class="mb-14 text-center max-w-3xl mx-auto space-y-3">
        <span class="text-xs font-bold uppercase tracking-widest text-scroll-lima bg-scroll-lima/10 px-4 py-1 rounded-full border border-scroll-lima/30 font-display">
          • Dentro del Sistema Scroll •
        </span>
        <h2 class="text-3xl sm:text-5xl font-display font-black text-white">
          ¿Por qué un cliente de $2M+ cancela a los 3 meses?
        </h2>
        <p class="text-sm text-slate-300">
          Scroll atiende a empresas medianas con planes de más de $2.000.000 COP. Las empresas no cancelan por falta de clics ni de alcance; cancelan cuando no ven dinero en caja.
        </p>
      </div>

      <!-- Gapless Bento Grid con grid-cols-12 -->
      <div class="grid grid-cols-1 md:grid-cols-12 gap-6 grid-flow-dense" id="bento-grid-container">
        
        <!-- Bento 1: La Fuga Silenciosa (Span 7) -->
        <div class="md:col-span-7 bezel-chassis p-7 flex flex-col justify-between space-y-6 relative overflow-hidden group">
          <div class="space-y-4">
            <div class="flex items-center justify-between">
              <span class="text-xs font-bold uppercase tracking-widest text-rose-400 bg-rose-500/10 px-3 py-1 rounded-full border border-rose-500/30 font-display">
                La Fuga del 70% de Leads
              </span>
              <i data-lucide="alert-triangle" class="w-5 h-5 text-rose-400"></i>
            </div>
            <h3 class="text-2xl font-display font-bold text-white leading-tight">
              Scroll crea campañas excelentes que traen 100 chats... pero la venta se quema en el celular del cliente
            </h3>
            <p class="text-xs sm:text-sm text-slate-300 leading-relaxed">
              El cliente demora de 3 a 6 horas en responder, o su recepcionista contesta con mensajes secos como <em>"Hola, sí dígame"</em>. El prospecto se enfría, le compra a la competencia y el cliente concluye: <strong class="text-white">"La agencia me trajo números pero no ventas"</strong>.
            </p>
          </div>

          <div class="p-4 rounded-2xl bg-black/60 border border-white/10 flex items-center justify-between">
            <div>
              <span class="text-[11px] text-slate-400 block uppercase font-bold">Tiempo de Respuesta Humano</span>
              <span class="text-2xl font-black text-rose-400 font-mono">3 - 6 Horas</span>
            </div>
            <div class="text-right">
              <span class="text-[11px] text-slate-400 block uppercase font-bold">Leads Perdidos por Fricción</span>
              <span class="text-2xl font-black text-rose-400 font-mono">70% Fuga</span>
            </div>
          </div>
        </div>

        <!-- Bento 2: La Solución Scroll IA (Span 5) -->
        <div class="md:col-span-5 bezel-chassis p-7 flex flex-col justify-between space-y-6 border-scroll-lima/40 bg-gradient-to-b from-scroll-blue/30 to-scroll-navy">
          <div>
            <div class="flex items-center justify-between mb-3">
              <span class="text-xs font-bold uppercase tracking-widest text-scroll-lima bg-scroll-lima/10 px-3 py-1 rounded-full border border-scroll-lima/30 font-display">
                Con Scroll Asesor IA
              </span>
              <i data-lucide="sparkles" class="w-5 h-5 text-scroll-lima"></i>
            </div>
            <h3 class="text-xl font-display font-bold text-white leading-tight">
              Respuesta en menos de 10 segundos y entrega de Lead Calificado
            </h3>
            <p class="text-xs text-slate-200 mt-3 leading-relaxed">
              La IA atiende 24/7 con el tono, catálogo y promociones de la empresa. Filtra a los curiosos, indaga el presupuesto y le pasa al asesor humano una <strong class="text-scroll-lima">ficha de cliente listo para pagar</strong>.
            </p>
          </div>

          <div class="p-4 rounded-2xl bg-scroll-dark/90 border border-scroll-lima/30 flex items-center justify-between">
            <div>
              <span class="text-[11px] text-slate-400 block uppercase font-bold">Velocidad del Asesor IA</span>
              <span class="text-2xl font-black text-scroll-lima font-mono">&lt; 10 Seg</span>
            </div>
            <div class="text-right">
              <span class="text-[11px] text-slate-400 block uppercase font-bold">Conversión Comercial</span>
              <span class="text-2xl font-black text-scroll-turquesaLight font-mono">+42% Cierres</span>
            </div>
          </div>
        </div>

        <!-- Bento 3: El Isotipo de Scroll (Span 4) -->
        <div class="md:col-span-4 bezel-chassis p-6 space-y-3">
          <div class="w-10 h-10 rounded-2xl bg-scroll-petroleo text-scroll-lima flex items-center justify-center border border-scroll-turquesa/30">
            <i data-lucide="message-circle" class="w-5 h-5"></i>
          </div>
          <h4 class="text-base font-bold text-white">El ADN de Scroll</h4>
          <p class="text-xs text-slate-300 leading-relaxed">
            El logo de Scroll es una burbuja de chat con una flecha verde que sube. Esta plataforma hace exactamente eso: <strong>convierte las conversaciones de WhatsApp en crecimiento y ventas</strong>.
          </p>
        </div>

        <!-- Bento 4: Cero Excusas Comerciales (Span 4) -->
        <div class="md:col-span-4 bezel-chassis p-6 space-y-3">
          <div class="w-10 h-10 rounded-2xl bg-scroll-turquesa/20 text-scroll-turquesa flex items-center justify-center border border-scroll-turquesa/30">
            <i data-lucide="file-check-2" class="w-5 h-5"></i>
          </div>
          <h4 class="text-base font-bold text-white">El Retorno es Indiscutible</h4>
          <p class="text-xs text-slate-300 leading-relaxed">
            Scroll le presenta a su cliente al final del mes: <em>"Te trajimos 180 conversaciones, la IA filtró 120 curiosos y te puso 60 prospectos calificados con plata en mano"</em>. El cliente no puede cancelar.
          </p>
        </div>

        <!-- Bento 5: Blindaje de Contratos (Span 4) -->
        <div class="md:col-span-4 bezel-chassis p-6 space-y-3">
          <div class="w-10 h-10 rounded-2xl bg-white/10 text-scroll-turquesaLight flex items-center justify-center border border-white/20">
            <i data-lucide="shield-check" class="w-5 h-5"></i>
          </div>
          <h4 class="text-base font-bold text-white">Retención de 3 a 12+ Meses</h4>
          <p class="text-xs text-slate-300 leading-relaxed">
            Al unir el marketing con la tecnología de ventas en WhatsApp, la agencia pasa de ser un proveedor prescindible a convertirse en el socio comercial estratégico del negocio.
          </p>
        </div>

      </div>

    </section>


    <!-- ============================================================== -->
    <!-- SECCIÓN 3: EXPERIENCIA EN VIVO (LOS 3 TELÉFONOS INTERACTIVOS) -->
    <!-- ============================================================== -->
    <section id="experiencia" class="py-20 sm:py-28 px-4 sm:px-6 max-w-7xl mx-auto border-t border-white/10">
      
      <div class="mb-10 text-center max-w-3xl mx-auto space-y-3">
        <span class="text-xs font-bold uppercase tracking-widest text-scroll-lima bg-scroll-lima/10 px-4 py-1 rounded-full border border-scroll-lima/30 font-display">
          • Demostración Interactiva •
        </span>
        <h2 class="text-3xl sm:text-5xl font-display font-black text-white">
          Prueba el Asesor IA en Vivo
        </h2>
        <p class="text-sm text-slate-300">
          Haz clic en las preguntas simuladas abajo para ver cómo la IA responde en tiempo real, perfila el cliente y genera el ticket de venta para el asesor humano.
        </p>
      </div>

      <!-- Quick Interactive Buttons Toolbar to Test the Bot Live -->
      <div class="flex flex-wrap items-center justify-center gap-2 mb-8 max-w-4xl mx-auto">
        <span class="text-xs font-bold text-slate-400 mr-2 flex items-center gap-1">
          <i data-lucide="hand-metal" class="w-3.5 h-3.5 text-scroll-lima"></i> Simular Pregunta:
        </span>
        <button onclick="simulateLeadQuestion(1)" class="px-3.5 py-1.5 rounded-full text-xs font-semibold bg-scroll-blue/60 hover:bg-scroll-blue border border-scroll-turquesa/40 text-white transition-all shadow-sm">
          "¿Qué precio tienen los servicios?"
        </button>
        <button onclick="simulateLeadQuestion(2)" class="px-3.5 py-1.5 rounded-full text-xs font-semibold bg-scroll-blue/60 hover:bg-scroll-blue border border-scroll-turquesa/40 text-white transition-all shadow-sm">
          "Tengo un presupuesto de $2M y requiero pauta urgente"
        </button>
        <button onclick="simulateLeadQuestion(3)" class="px-3.5 py-1.5 rounded-full text-xs font-semibold bg-scroll-blue/60 hover:bg-scroll-blue border border-scroll-turquesa/40 text-white transition-all shadow-sm">
          "Quiero agendar una reunión con un asesor hoy"
        </button>
      </div>

      <!-- 3 PHONE MOCKUPS (FAITHFUL TO USER'S REFERENCE IMAGE) -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 max-w-6xl w-full mx-auto" id="phones-experience-grid">
        
        <!-- CARD 1: DARK THEME PHONE (CHAT EN VIVO DE WHATSAPP) -->
        <div class="phone-mockup bg-[#091826] p-5 flex flex-col justify-between min-h-[530px]">
          <div>
            <!-- Top App Bar -->
            <div class="flex items-center justify-between pb-3 border-b border-white/10 mb-3">
              <div class="flex items-center gap-2.5">
                <div class="w-8 h-8 rounded-full bg-scroll-petroleo flex items-center justify-center text-scroll-lima font-bold text-xs border border-scroll-turquesa/40">
                  <i data-lucide="bot" class="w-4 h-4"></i>
                </div>
                <div>
                  <h4 class="text-xs font-bold text-white flex items-center gap-1.5">
                    Scroll Asesor IA
                    <span class="w-1.5 h-1.5 rounded-full bg-scroll-lima"></span>
                  </h4>
                  <p class="text-[10px] text-scroll-turquesaLight">En línea las 24 horas</p>
                </div>
              </div>
              <span class="text-[10px] bg-white/10 text-slate-300 px-2.5 py-0.5 rounded-full font-mono">WhatsApp</span>
            </div>

            <!-- Leads Attended Display (Like Image Header) -->
            <div class="bg-[#0e253b] p-3.5 rounded-2xl border border-white/5 mb-3.5">
              <div class="flex items-center justify-between">
                <span class="text-[10px] text-slate-400 uppercase tracking-wider font-semibold">Leads Atendidos Hoy</span>
                <i data-lucide="message-square" class="w-3.5 h-3.5 text-scroll-lima"></i>
              </div>
              <p class="text-2xl font-display font-black text-white mt-1" id="mockupLeadsToday">48 <span class="text-xs text-scroll-lima font-normal font-sans">+18 vs ayer</span></p>
            </div>

            <!-- 4 Circular Action Icons (Faithful to Reference Image) -->
            <div class="grid grid-cols-4 gap-2 text-center mb-4">
              <div class="flex flex-col items-center">
                <div class="w-10 h-10 rounded-2xl bg-[#032747] text-scroll-turquesaLight flex items-center justify-center border border-scroll-turquesa/20 text-xs">
                  <i data-lucide="send" class="w-4 h-4"></i>
                </div>
                <span class="text-[9px] text-slate-300 mt-1 font-medium">Enviar</span>
              </div>
              <div class="flex flex-col items-center">
                <div class="w-10 h-10 rounded-2xl bg-[#032747] text-scroll-lima flex items-center justify-center border border-scroll-lima/20 text-xs">
                  <i data-lucide="tag" class="w-4 h-4"></i>
                </div>
                <span class="text-[9px] text-slate-300 mt-1 font-medium">Catálogo</span>
              </div>
              <div class="flex flex-col items-center">
                <div class="w-10 h-10 rounded-2xl bg-[#032747] text-slate-300 flex items-center justify-center border border-white/10 text-xs">
                  <i data-lucide="check-check" class="w-4 h-4"></i>
                </div>
                <span class="text-[9px] text-slate-300 mt-1 font-medium">Calificar</span>
              </div>
              <div class="flex flex-col items-center">
                <div class="w-10 h-10 rounded-2xl bg-[#032747] text-slate-300 flex items-center justify-center border border-white/10 text-xs">
                  <i data-lucide="user-check" class="w-4 h-4"></i>
                </div>
                <span class="text-[9px] text-slate-300 mt-1 font-medium">Traspaso</span>
              </div>
            </div>

            <!-- Dynamic Chat Bubbles -->
            <div class="space-y-2.5 text-xs" id="chatSimulatorBox">
              <div class="bg-[#163652] text-slate-200 p-3 rounded-2xl rounded-tl-sm max-w-[88%] border border-white/5">
                <p class="text-[11px] leading-relaxed" id="userBubbleText">¡Hola! Vi su anuncio de redes y pauta en Instagram. ¿Qué precio manejan?</p>
                <span class="text-[9px] text-slate-400 block text-right mt-0.5">10:42 AM</span>
              </div>
              <div class="bg-scroll-blue text-white p-3 rounded-2xl rounded-tr-sm ml-auto max-w-[90%] border border-scroll-turquesa/30 shadow-md">
                <p class="text-[11px] leading-relaxed" id="botBubbleText">¡Hola! 👋 Qué gusto saludarte. En Scroll diseñamos planes según el tamaño y la meta de cada empresa. Para orientarte mejor, ¿cuántos colaboradores tiene tu negocio y en qué ciudad te encuentras?</p>
                <span class="text-[9px] text-scroll-turquesaLight block text-right mt-0.5">10:42 AM · IA Scroll</span>
              </div>
            </div>
          </div>

          <!-- Bottom Typing Indicator -->
          <div class="bg-[#0b1f31] px-3.5 py-2.5 rounded-xl flex items-center justify-between text-[11px] text-slate-400 border border-white/5 mt-3">
            <span class="flex items-center gap-1.5">
              <span id="typingStatusLabel">IA respondiendo en tiempo real</span>
              <span class="inline-flex gap-1" id="typingDots">
                <span class="w-1.5 h-1.5 rounded-full bg-scroll-lima typing-dot-1"></span>
                <span class="w-1.5 h-1.5 rounded-full bg-scroll-lima typing-dot-2"></span>
                <span class="w-1.5 h-1.5 rounded-full bg-scroll-lima typing-dot-3"></span>
              </span>
            </span>
            <span class="text-scroll-lima text-[10px] font-mono font-bold" id="responseTimeLabel">&lt; 0.8s</span>
          </div>
        </div>


        <!-- CARD 2: TEAL THEME PHONE (MÉTRICAS & CATEGORÍAS APILADAS) -->
        <div class="phone-mockup bg-[#042838] p-5 flex flex-col justify-between min-h-[530px] border-scroll-turquesa/40">
          <div>
            <!-- Top Header -->
            <div class="flex items-center justify-between pb-3 border-b border-scroll-turquesa/20 mb-3">
              <div>
                <span class="text-[10px] uppercase font-bold text-scroll-turquesaLight tracking-wider">Dashboard de Resultados</span>
                <h4 class="text-xs font-bold text-white">Retorno de Marketing</h4>
              </div>
              <div class="w-7 h-7 rounded-full bg-scroll-turquesa/20 text-scroll-turquesa flex items-center justify-center">
                <i data-lucide="bar-chart-2" class="w-3.5 h-3.5"></i>
              </div>
            </div>

            <!-- Big Number Metric (Faithful to Reference Image) -->
            <div class="text-center py-2 mb-3">
              <span class="text-[10px] text-slate-300 font-medium">Volumen Potencial Detectado</span>
              <p class="text-3xl font-display font-black text-white tracking-tight mt-0.5" id="dashboardVolumeNumber">$14.850.000</p>
              <span class="inline-block mt-1 text-[10px] font-bold bg-scroll-lima/20 text-scroll-lima border border-scroll-lima/40 px-2.5 py-0.5 rounded-full font-mono">
                +42% Cierres asistidos
              </span>
            </div>

            <!-- 3 Stacked Rounded Category Cards (Like Reference Image Middle Phone) -->
            <div class="space-y-2.5">
              <div class="bg-[#083a52] p-3 rounded-2xl flex items-center justify-between border border-scroll-turquesa/20">
                <div class="flex items-center gap-2.5">
                  <div class="w-8 h-8 rounded-xl bg-scroll-turquesa/20 text-scroll-turquesaLight flex items-center justify-center text-xs">
                    <i data-lucide="flame" class="w-4 h-4"></i>
                  </div>
                  <div>
                    <h5 class="text-xs font-bold text-white">Leads Calientes</h5>
                    <p class="text-[10px] text-slate-300">Con presupuesto alto</p>
                  </div>
                </div>
                <span class="text-xs font-extrabold text-white font-mono" id="hotLeadsValue">$8.200.000</span>
              </div>

              <div class="bg-[#083a52] p-3 rounded-2xl flex items-center justify-between border border-scroll-turquesa/20">
                <div class="flex items-center gap-2.5">
                  <div class="w-8 h-8 rounded-xl bg-scroll-lima/20 text-scroll-lima flex items-center justify-center text-xs">
                    <i data-lucide="clock" class="w-4 h-4"></i>
                  </div>
                  <div>
                    <h5 class="text-xs font-bold text-white">Citas Agendadas</h5>
                    <p class="text-[10px] text-slate-300">Seguimiento hoy</p>
                  </div>
                </div>
                <span class="text-xs font-extrabold text-white font-mono" id="scheduledAppointmentsValue">$4.650.000</span>
              </div>

              <div class="bg-[#083a52] p-3 rounded-2xl flex items-center justify-between border border-scroll-turquesa/20">
                <div class="flex items-center gap-2.5">
                  <div class="w-8 h-8 rounded-xl bg-white/10 text-white flex items-center justify-center text-xs">
