      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 max-w-5xl mx-auto">
        
        <!-- Método Actual: WhatsApp Web (QR) -->
        <div class="bezel-chassis p-7 rounded-3xl border-scroll-lima/40 bg-gradient-to-b from-[#032a4a]/60 to-[#011a33]/90 space-y-4">
          <div class="flex items-center justify-between">
            <span class="text-xs font-bold uppercase tracking-wider text-scroll-lima bg-scroll-lima/10 px-3 py-1 rounded-full border border-scroll-lima/30 font-display">
