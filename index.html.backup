  </div>


  <!-- ============================================================== -->
  <!-- HIGH PERFORMANCE JAVASCRIPT (GSAP SCROLLTRIGGER 3D + SIMULATOR + CANVAS) -->
  <!-- ============================================================== -->
  <script>
    // Initialize Lucide Icons
    lucide.createIcons();

    /* ==========================================================================
       1. GSAP SCROLLTRIGGER 3D DIVE & DIMENSIÓN MARKETING
       - El celular se pone en horizontal
       - La flecha oficial verde lima de Scroll orbita el celular en 3D
       - Se adentra en la pantalla del celular hacia la Dimensión Marketing (Cámaras, Micrófonos, Mouse...)
       - Transición inmediata a #vision sin espacios vacíos
       ========================================================================== */
    let heroST = null;

    window.addEventListener('DOMContentLoaded', () => {
      if (typeof gsap !== 'undefined' && typeof ScrollTrigger !== 'undefined') {
        gsap.registerPlugin(ScrollTrigger);

        // Setup marketing 3D props initial states
        gsap.set('#mkt-camera', { x: -300, y: -180, scale: 0.8, opacity: 0 });
        gsap.set('#mkt-mic', { x: 320, y: 160, scale: 0.8, opacity: 0 });
        gsap.set('#mkt-mouse', { x: -320, y: 180, scale: 0.8, opacity: 0 });
        gsap.set('#mkt-clapper', { x: 300, y: -180, scale: 0.8, opacity: 0 });
        gsap.set('#mkt-ticket', { x: 0, y: 0, scale: 0.5, opacity: 0 });

        // The Master Dive Timeline
        const diveTimeline = gsap.timeline();

        // 1. Columnas laterales se desvanecen suavemente hacia los lados
        diveTimeline.to("#hero-left-col", {
          x: -140,
          opacity: 0,
          scale: 0.88,
          duration: 0.22,
          ease: "power2.inOut"
        }, 0);

        diveTimeline.to("#hero-right-col", {
          x: 140,
          opacity: 0,
          scale: 0.88,
          duration: 0.22,
          ease: "power2.inOut"
        }, 0);

        // Desvanecer el badge de notificación cuando la flecha despega
        diveTimeline.to("#arrow-notification-badge", {
          opacity: 0,
          scale: 0.5,
          duration: 0.15,
          ease: "power1.in"
        }, 0.05);

        // 2. El celular SE PONE EN HORIZONTAL (rotación -90 grados limpia, sin cortes)
        diveTimeline.to("#hero-phone-mockup", {
          rotateZ: -90,
          scale: 1.25,
          duration: 0.35,
          ease: "power2.inOut"
        }, 0.05);

        // 3. LA FLECHA VERDE LIMA SALE DE LA PANTALLA EN 3D Y ORBITA RODEANDO EL CELULAR
        diveTimeline.to("#scroll-lime-arrow-3d", {
          z: 380,
          x: 320,
          y: -180,
          scale: 1.8,
          rotateY: 45,
          rotateX: -20,
          rotateZ: -15,
          duration: 0.35,
          ease: "power2.inOut"
        }, 0.05);

        // Completa la órbita 3D rodeando el chasis por el otro costado
        diveTimeline.to("#scroll-lime-arrow-3d", {
          x: -300,
          y: 150,
          z: 280,
          rotateY: -45,
          rotateZ: 25,
          scale: 1.6,
          duration: 0.3,
          ease: "power2.inOut"
        }, 0.38);

        // Desvanecer UI interna de la llamada del celular
        diveTimeline.to(["#call-header", "#call-footer", "#phone-notch", "#call-base-plinth"], {
          opacity: 0,
          duration: 0.2
        }, 0.42);

        // 4. La flecha vuelve a entrar al centro de la pantalla guiando la inmersión
        diveTimeline.to("#scroll-lime-arrow-3d", {
          x: 0,
          y: 0,
          z: 140,
          rotateY: 0,
          rotateX: 0,
          rotateZ: 0,
          scale: 1.8,
          duration: 0.18,
          ease: "power2.out"
        }, 0.62);

        // 5. El celular en horizontal escala masivamente llenando la pantalla y abriendo el portal
        diveTimeline.to("#hero-phone-mockup", {
          scale: 9,
          opacity: 0,
          duration: 0.38,
          ease: "power2.in"
        }, 0.52);

        // 6. Revelar la DIMENSIÓN DE MARKETING
        diveTimeline.to("#marketing-dimension", {
          opacity: 1,
          duration: 0.18
        }, 0.55);

        // 7. ELEMENTOS DE MARKETING (Cámaras, micrófonos, mouse, claqueta, ticket)
        // Vuelan en hiperespacio hacia el espectador acompañando la entrada
        diveTimeline.to("#mkt-camera", {
          x: -620,
          y: -380,
          scale: 2.8,
          opacity: 1,
          duration: 0.34,
          ease: "power2.in"
        }, 0.58);
        diveTimeline.to("#mkt-camera", { opacity: 0, duration: 0.08 }, 0.86);

        diveTimeline.to("#mkt-mic", {
          x: 620,
          y: 380,
          scale: 2.8,
          opacity: 1,
          duration: 0.34,
          ease: "power2.in"
        }, 0.60);
        diveTimeline.to("#mkt-mic", { opacity: 0, duration: 0.08 }, 0.86);

        diveTimeline.to("#mkt-mouse", {
          x: -550,
          y: 380,
          scale: 2.5,
          opacity: 1,
          duration: 0.32,
          ease: "power2.in"
        }, 0.59);
        diveTimeline.to("#mkt-mouse", { opacity: 0, duration: 0.08 }, 0.86);

        diveTimeline.to("#mkt-clapper", {
          x: 550,
          y: -380,
          scale: 2.6,
          opacity: 1,
          duration: 0.34,
          ease: "power2.in"
        }, 0.60);
        diveTimeline.to("#mkt-clapper", { opacity: 0, duration: 0.08 }, 0.86);

        diveTimeline.to("#mkt-ticket", {
          scale: 2.4,
          opacity: 1,
          duration: 0.28,
          ease: "power2.in"
        }, 0.64);
        diveTimeline.to("#mkt-ticket", { opacity: 0, duration: 0.08 }, 0.86);

        // 8. LA FLECHA LIMA SE ADENTRA EN EL NÚCLEO CON DESTELLO Y CRUZA LA CÁMARA
        diveTimeline.to("#scroll-lime-arrow-3d", {
          scale: 7,
          z: 1000,
          opacity: 0,
          filter: "brightness(3) blur(10px)",
          duration: 0.28,
          ease: "power2.in"
        }, 0.68);

        // Flash sutil de transición
        diveTimeline.to("#dive-portal-curtain", {
          opacity: 0.7,
          duration: 0.2,
          ease: "power1.inOut"
        }, 0.68);
        diveTimeline.to("#dive-portal-curtain", {
          opacity: 0,
          duration: 0.15,
          ease: "power1.out"
        }, 0.88);

        // 9. La dimensión marketing se disuelve justo antes de soltar el pin
        diveTimeline.to("#marketing-dimension", {
          opacity: 0,
          duration: 0.08
        }, 0.92);

        // ScrollTrigger sincronizado con sticky nativo: Cero espacio muerto hacia #vision
        heroST = ScrollTrigger.create({
          trigger: "#hero-pin-wrapper",
          start: "top top",
          end: "bottom bottom",
          scrub: 1.1,
          animation: diveTimeline
        });

        // Section Stagger Reveals on Scroll
        gsap.from("#bento-grid-container > div", {
          scrollTrigger: {
            trigger: "#vision",
            start: "top 75%",
            toggleActions: "play none none none"
          },
          opacity: 0,
          y: 40,
          stagger: 0.12,
          duration: 0.9,
          ease: "power2.out"
        });

        gsap.from("#phones-experience-grid > div", {
          scrollTrigger: {
            trigger: "#experiencia",
            start: "top 75%",
            toggleActions: "play none none none"
          },
          opacity: 0,
          y: 45,
          stagger: 0.15,
          duration: 1,
          ease: "back.out(1.2)"
        });

        gsap.from("#pricing-cards-container > div", {
          scrollTrigger: {
            trigger: "#precios",
            start: "top 75%",
            toggleActions: "play none none none"
          },
          opacity: 0,
          y: 50,
          stagger: 0.15,
          duration: 1,
          ease: "power3.out"
        });
      }
    });

    // Helper: Contestar la llamada y reproducir la inmersión suavemente
    function answerCall() {
      if (heroST) {
        window.scrollTo({
          top: heroST.end + 5,
          behavior: 'smooth'
        });
      } else {
        const visionSection = document.getElementById('vision');
        if (visionSection) {
          visionSection.scrollIntoView({ behavior: 'smooth' });
        }
      }
    }

    /* ==========================================================================
       2. AMBIENT GPU CANVAS (SCROLL VOLUMETRIC ORBS & EMBERS)
       ========================================================================== */
    const canvas = document.getElementById('ambient-canvas');
    const ctx = canvas ? canvas.getContext('2d') : null;

    let width = 0, height = 0;
    let mouse = { x: -100, y: -100, targetX: -100, targetY: -100 };
    let embers = [];
    let isCanvasActive = true;

    const orbs = [
      { x: 0.15, y: 0.15, r: 0.42, color: 'rgba(4, 62, 113, 0.28)', vx: 0.00025, vy: 0.0002 },
      { x: 0.85, y: 0.30, r: 0.45, color: 'rgba(2, 204, 181, 0.16)', vx: -0.0002, vy: 0.0003 },
      { x: 0.50, y: 0.70, r: 0.48, color: 'rgba(174, 249, 5, 0.09)', vx: 0.00015, vy: -0.00015 },
      { x: 0.20, y: 0.90, r: 0.38, color: 'rgba(3, 51, 105, 0.25)', vx: -0.0002, vy: -0.0002 }
    ];

    function resizeCanvas() {
      if (!canvas) return;
      width = canvas.width = window.innerWidth;
      height = canvas.height = window.innerHeight;
    }

    function initEmbers() {
      embers = [];
      const count = window.innerWidth < 768 ? 16 : 32;
      for (let i = 0; i < count; i++) {
        embers.push({
          x: Math.random() * width,
          y: Math.random() * height,
          size: Math.random() * 2.2 + 1,
          speedY: Math.random() * 0.4 + 0.2,
          speedX: (Math.random() - 0.5) * 0.25,
          opacity: Math.random() * 0.6 + 0.2,
          pulse: Math.random() * Math.PI * 2,
          pulseSpeed: Math.random() * 0.03 + 0.015,
          color: Math.random() > 0.4 ? 'rgba(174, 249, 5, ' : 'rgba(2, 204, 181, '
        });
      }
    }

    function drawAmbientCanvas() {
      if (!isCanvasActive || !ctx) return;

      ctx.clearRect(0, 0, width, height);

      // Dark Base
      ctx.fillStyle = '#01122a';
      ctx.fillRect(0, 0, width, height);

      // Smooth Ambient Orbs
      orbs.forEach(orb => {
        orb.x += orb.vx;
        orb.y += orb.vy;
        if (orb.x < 0.05 || orb.x > 0.95) orb.vx *= -1;
        if (orb.y < 0.05 || orb.y > 0.95) orb.vy *= -1;

        const cx = orb.x * width + (mouse.x - width / 2) * 0.03;
        const cy = orb.y * height + (mouse.y - height / 2) * 0.03;
        const radius = Math.min(width, height) * orb.r;

        const grad = ctx.createRadialGradient(cx, cy, 0, cx, cy, radius);
        grad.addColorStop(0, orb.color);
        grad.addColorStop(1, 'rgba(1, 18, 42, 0)');

        ctx.fillStyle = grad;
        ctx.beginPath();
        ctx.arc(cx, cy, radius, 0, Math.PI * 2);
        ctx.fill();
      });

      // Floating Embers
      embers.forEach(p => {
        p.y -= p.speedY;
        p.x += p.speedX;
        p.pulse += p.pulseSpeed;

        if (p.y < -10) {
          p.y = height + 10;
          p.x = Math.random() * width;
        }
        if (p.x < -10) p.x = width + 10;
        if (p.x > width + 10) p.x = -10;

        const currentAlpha = p.opacity * (0.6 + Math.sin(p.pulse) * 0.4);
        ctx.fillStyle = p.color + currentAlpha + ')';
        ctx.beginPath();
        ctx.arc(p.x, p.y, p.size, 0, Math.PI * 2);
        ctx.fill();
      });

      requestAnimationFrame(drawAmbientCanvas);
    }

    document.addEventListener('visibilitychange', () => {
      isCanvasActive = !document.hidden;
      if (isCanvasActive) requestAnimationFrame(drawAmbientCanvas);
    });

    window.addEventListener('resize', () => {
      resizeCanvas();
      initEmbers();
      if (typeof ScrollTrigger !== 'undefined') ScrollTrigger.refresh();
    });

    resizeCanvas();
    initEmbers();
    requestAnimationFrame(drawAmbientCanvas);

    /* ==========================================================================
       3. MAGNETIC PRECISION CURSOR
       ========================================================================== */
    const cursor = document.getElementById('custom-cursor');
    const dot = document.getElementById('custom-cursor-dot');
    let curX = -100, curY = -100;
    let dotX = -100, dotY = -100;

    window.addEventListener('mousemove', (e) => {
      mouse.targetX = e.clientX;
      mouse.targetY = e.clientY;
      mouse.x += (mouse.targetX - mouse.x) * 0.1;
      mouse.y += (mouse.targetY - mouse.y) * 0.1;
    }, { passive: true });

    function renderCursor() {
      if (cursor && dot) {
        curX += (mouse.targetX - curX) * 0.15;
        curY += (mouse.targetY - curY) * 0.15;
        dotX += (mouse.targetX - dotX) * 0.6;
        dotY += (mouse.targetY - dotY) * 0.6;

        cursor.style.transform = `translate3d(${curX - 16}px, ${curY - 16}px, 0)`;
        dot.style.transform = `translate3d(${dotX - 3}px, ${dotY - 3}px, 0)`;
      }
      requestAnimationFrame(renderCursor);
    }
    requestAnimationFrame(renderCursor);

    document.addEventListener('mouseover', (e) => {
      if (e.target.closest('a, button, input, .phone-mockup, #scroll-lime-arrow-3d')) {
        if (cursor) {
          cursor.style.width = '48px';
          cursor.style.height = '48px';
          cursor.style.backgroundColor = 'rgba(174, 249, 5, 0.12)';
          cursor.style.borderColor = '#AEF905';
        }
      }
    });
    document.addEventListener('mouseout', (e) => {
      if (e.target.closest('a, button, input, .phone-mockup, #scroll-lime-arrow-3d')) {
        if (cursor) {
          cursor.style.width = '32px';
          cursor.style.height = '32px';
          cursor.style.backgroundColor = 'transparent';
          cursor.style.borderColor = 'rgba(2, 204, 181, 0.7)';
        }
      }
    });

    /* ==========================================================================
       4. LIVE WHATSAPP SIMULATOR ENGINE (SHOWCASE FOR BOARD MEETINGS)
       ========================================================================== */
    const leadScenarios = {
      1: {
        userText: "¡Hola! Vi su anuncio de redes y pauta en Instagram. ¿Qué precio manejan?",
        botText: "¡Hola! 👋 En Scroll personalizamos cada propuesta para que el retorno sea superior a la inversión. Manejamos planes desde $2.000.000 COP para empresas medianas. ¿Qué tipo de negocio tienes y cuál es tu meta este trimestre?",
        budget: "$2.000.000 COP",
        clientName: "Carolina Gómez",
        clientPhone: "+57 314 620 9941",
        avatar: "CG",
        interest: "Plan Marketing Mensual",
        urgency: "Media (Cotizando este mes)",
        leadsToday: "49",
        volume: "$16.850.000"
      },
      2: {
        userText: "Hola, tengo un presupuesto de $2.5M para pauta en Pereira y necesitamos arrancar ya esta semana.",
        botText: "¡Excelente! Con ese presupuesto podemos estructurar una campaña de alto rendimiento en Meta y Google Ads con asesoría en WhatsApp. Te agendo de inmediato con nuestro director de estrategia.",
        budget: "$2.500.000 COP",
        clientName: "Andrés Felipe Meza",
        clientPhone: "+57 320 514 8832",
        avatar: "AM",
        interest: "Pauta Ads + Setup Bot WhatsApp",
        urgency: "Alta (Esta semana)",
        leadsToday: "50",
        volume: "$19.350.000"
      },
      3: {
        userText: "Buenas tardes, quiero agendar una reunión presencial con un asesor de Scroll hoy en la oficina.",
        botText: "¡Perfecto! Con gusto te recibimos en nuestras oficinas de Pereira. Tenemos disponibilidad hoy a las 3:30 PM o a las 5:00 PM. ¿Cuál horario te queda mejor para confirmar tu cita?",
        budget: "$3.000.000 COP",
        clientName: "Dr. Roberto Echeverry",
        clientPhone: "+57 311 748 1029",
        avatar: "RE",
        interest: "Consultoría Estratégica Integral",
        urgency: "Urgente (Reunión Hoy)",
        leadsToday: "51",
        volume: "$22.350.000"
      }
    };

    function simulateLeadQuestion(scenarioId) {
      const data = leadScenarios[scenarioId];
      if (!data) return;

      const userText = document.getElementById('userBubbleText');
      const botText = document.getElementById('botBubbleText');
      const statusLabel = document.getElementById('typingStatusLabel');
      const responseTime = document.getElementById('responseTimeLabel');

      userText.textContent = data.userText;
      botText.textContent = "Escribiendo respuesta personalizada con catálogo...";
      statusLabel.textContent = "IA consultando catálogo y reglas...";
      responseTime.textContent = "pensando...";

      setTimeout(() => {
        botText.textContent = data.botText;
        statusLabel.textContent = "Respuesta enviada y lead calificado";
        responseTime.textContent = "< 0.8s";

        // Update Dashboard phone
        document.getElementById('mockupLeadsToday').innerHTML = `${data.leadsToday} <span class="text-xs text-scroll-lima font-normal font-sans">+${parseInt(data.leadsToday)-30} vs ayer</span>`;
        document.getElementById('dashboardVolumeNumber').textContent = data.volume;

        // Update Voucher phone
        document.getElementById('ticketBudgetAmount').innerHTML = `${data.budget}`;
        document.getElementById('ticketClientName').textContent = data.clientName;
        document.getElementById('ticketClientPhone').textContent = data.clientPhone;
        document.getElementById('ticketClientAvatar').textContent = data.avatar;
        document.getElementById('ticketInterestLabel').textContent = data.interest;
        document.getElementById('ticketUrgencyLabel').textContent = data.urgency;
      }, 650);
    }

    /* ==========================================================================
       5. ROI CALCULATOR
       ========================================================================== */
    function calculateROI() {
      const clients = parseInt(document.getElementById('clientsRange').value, 10);
      const pricePerClient = parseInt(document.getElementById('priceRange').value, 10);

      document.getElementById('clientsCountDisplay').textContent = `${clients} ${clients === 1 ? 'empresa' : 'empresas'}`;
      document.getElementById('pricePerClientDisplay').textContent = `$${pricePerClient.toLocaleString('es-CO')} COP`;

      const totalMonthly = clients * pricePerClient;
      const licenseCost = clients * 90000; // Option C base
      const netProfit = totalMonthly - licenseCost;
      const annualProfit = netProfit * 12;

      document.getElementById('totalMonthlyIncome').textContent = `$${totalMonthly.toLocaleString('es-CO')}`;
      document.getElementById('licenseCostDisplay').textContent = `$${licenseCost.toLocaleString('es-CO')}`;
      document.getElementById('netProfitDisplay').textContent = `$${netProfit.toLocaleString('es-CO')}`;
      document.getElementById('annualProfitDisplay').textContent = `$${annualProfit.toLocaleString('es-CO')} COP`;
    }
    calculateROI();

    /* ==========================================================================
       6. CELEBRATION CONFETTI APPROVAL
       ========================================================================== */
    function approveProposal() {
      if (typeof confetti === 'function') {
        confetti({
          particleCount: 120,
          spread: 80,
          origin: { y: 0.6 },
          colors: ['#AEF905', '#02CCB5', '#033369', '#FFFFFF']
        });
        setTimeout(() => {
          confetti({
            particleCount: 80,
            angle: 60,
            spread: 60,
            origin: { x: 0 },
            colors: ['#AEF905', '#02E7C1', '#043E71']
          });
          confetti({
            particleCount: 80,
            angle: 120,
            spread: 60,
            origin: { x: 1 },
            colors: ['#AEF905', '#02E7C1', '#043E71']
          });
        }, 250);
      }

      setTimeout(() => {
        window.open('https://wa.me/573000000000?text=Hola%20Santiago,%20revisamos%20la%20propuesta%20de%20Scroll%20y%20queremos%20avanzar.', '_blank');
      }, 900);
    }
  </script>
</body>
</html>
